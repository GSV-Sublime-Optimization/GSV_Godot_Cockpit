extends SceneTree

const ATLAS = preload("res://scripts/workstation/WorkbenchToolAtlas.gd")
const PROJECTION = preload("res://scripts/workstation/WorkbenchSpatialProjection.gd")
var failures: Array[String] = []

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	const NOW := 1762590000
	var payload := {
		"schema": "gsv.workstation.tool-atlas.v1",
		"observed_at_unix": NOW,
		"tools": [
			{"id": "omnisynapse", "name": "OMNISYNAPSE", "state": "source_present",
				"path": "C:/dev/active/OMNISYNAPSE", "secret": "must_not_copy"},
			{"id": "obsidian", "name": "Obsidian vault", "state": "not_found",
				"path": "C:/dev/vault"}
		]
	}
	var result: Dictionary = ATLAS.parse(JSON.stringify(payload), NOW + 10)
	_check(result["state"] == "observed", "fresh exact schema accepted")
	_check(result["tools"].size() == 2, "two explicit tools only")
	_check(not JSON.stringify(result).contains("must_not_copy"), "unknown/private fields are not carried")
	var graph: Dictionary = PROJECTION.project({
		"tool_atlas_state": "observed", "tools": result["tools"]
	})
	_check(graph["nodes"].size() == 6, "four rigs plus two source-discovery tools")
	_check(graph["edges"].is_empty(), "filesystem source presence alone never authorizes a relation")
	var joined: Dictionary = PROJECTION.project({
		"tool_atlas_state": "observed", "tools": result["tools"],
		"project_feed_state": "observed",
		"projects": [{"name": "Observed integration repo", "path": "C:/dev/active/OMNISYNAPSE", "branch": "main"}]
	})
	_check(joined["nodes"].size() == 7, "joined atlas adds only the observed project")
	_check(joined["edges"].size() == 1, "only exact independent local-path match cross-references")
	if joined["edges"].size() == 1:
		_check(joined["edges"][0]["kind"] == "local_path_match", "local cross-reference not labelled proof of execution")
	if graph["nodes"].size() >= 5:
		_check(graph["nodes"][4]["status"] == "source_present", "present means discovered, not running")
		_check(graph["nodes"][4]["kind"] == "tool", "tool remains a distinct domain")
	_check(ATLAS.parse(JSON.stringify(payload), NOW + 301)["state"] == "stale", "aged inventory refuses freshness")
	_check(PROJECTION.project({"tool_atlas_state": "stale", "tools": result["tools"]})["nodes"].size() == 4,
		"stale atlas cannot display purported current tools")
	payload["tools"][0]["state"] = "live"
	_check(ATLAS.parse(JSON.stringify(payload), NOW)["state"] == "invalid", "presence cannot assert live capability")
	payload["tools"][0]["state"] = "source_present"
	payload["tools"].append(payload["tools"][0].duplicate(true))
	_check(ATLAS.parse(JSON.stringify(payload), NOW)["state"] == "invalid", "duplicate IDs denied")
	payload["tools"].pop_back()
	payload["observed_at_unix"] = NOW + 45
	_check(ATLAS.parse(JSON.stringify(payload), NOW)["state"] == "invalid", "future time spoof denied")
	payload["observed_at_unix"] = NOW
	payload["tools"][1]["path"] = "../secret"
	_check(ATLAS.parse(JSON.stringify(payload), NOW)["state"] == "invalid", "relative path denied")
	_check(ATLAS.parse("{no json", NOW)["state"] == "invalid", "malformed json fails closed")
	_check(ATLAS.parse("x".repeat(70000), NOW)["state"] == "invalid", "oversized input denied")
	# Optional integration canary: operator-supplied local snapshot generated by
	# tools/workstation/collect_tool_atlas.py. No external network or process here.
	if not OS.get_environment("GSV_WORKSTATION_TOOL_ATLAS").is_empty():
		var local: Dictionary = ATLAS.load_from_environment()
		_check(local["state"] == "observed", "real local collector snapshot accepted")
		_check(local.get("tools", []).size() > 0, "real source scan returns discovered tools")
	if failures.is_empty():
		print("WORKSTATION_TOOL_ATLAS_PASS")
		quit(0)
	else:
		for message in failures:
			printerr("WORKSTATION_TOOL_ATLAS_FAIL: " + message)
		quit(1)

func _check(condition: bool, message: String) -> void:
	if not condition:
		failures.append(message)
